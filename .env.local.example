# =============================================================================
# OPENROUTER — untuk AI Copilot (narasi, kesimpulan, chat)
# =============================================================================
# 1. Daftar gratis di https://openrouter.ai → Settings → Keys
# 2. Free tier ~20 req/menit, ~50 req/hari per akun.
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_REFERER=https://grafio.local


# =============================================================================
# SUPABASE — untuk user login & project save
# =============================================================================
# Setup (gratis, ~5 menit):
# 1. Buka https://supabase.com → New project (pilih region terdekat: Singapore)
# 2. Tunggu provisioning ~1 menit
# 3. Di project: Settings → API → copy "Project URL" dan "anon public" key
# 4. Paste di bawah
# 5. Di SQL Editor → New query → paste isi `supabase/schema.sql` → RUN
# 6. (Production) di Authentication → Providers → Email: aktifkan "Enable email signup"
#    Untuk dev cepat: matikan "Confirm email" supaya tidak perlu klik link verifikasi
#
# Catatan keamanan: anon key AMAN di-expose ke client. RLS policies di schema
# memastikan user hanya bisa baca/tulis row milik mereka sendiri.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
