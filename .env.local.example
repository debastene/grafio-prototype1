# Grafio menggunakan OpenRouter free-tier untuk AI Copilot.
# 1. Daftar gratis di https://openrouter.ai → Settings → Keys
# 2. Copy file ini menjadi `.env.local` lalu isi key di bawah
# 3. Restart `npm run dev`
#
# Free tier rate limit ~20 req/menit, ~50 req/hari per akun.
OPENROUTER_API_KEY=sk-or-v1-...

# Optional — ditampilkan di OpenRouter analytics dashboard.
OPENROUTER_REFERER=https://grafio.local
